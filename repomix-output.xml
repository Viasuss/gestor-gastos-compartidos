        <!-- NUEVO: botón "x" del Figma, para quitar a la persona
             de la lista antes de crear el grupo. Es un form aparte
             (no un link) porque quitar algo es una ACCIÓN que
             modifica datos (la lista en sesión), y esas acciones
             deben ir por POST, no por un simple GET de un link. -->
        <form th:action="@{/grupo/quitar-usuario}"
              method="post"
              style="display:inline;">

            <input type="hidden" name="email" th:value="${email}">

            <button type="submit">✕</button>

        </form>

    </li>

</ul>

<p th:if="${#lists.isEmpty(usuariosTemporales)}">
