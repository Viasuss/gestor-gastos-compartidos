            placeholder="Ej: usuario@gmail.com"
            required>

    <button type="submit">
        Agregar
    </button>

</form>

<br>

<!-- Mensaje de error -->
<!-- NUEVO: mensaje específico para el bug de autoinvitarse.
     Como el controlador ahora manda ?error=propio en ese caso,
     agregamos un th:if aparte para mostrar un texto claro,
     distinto del error genérico de "usuario no encontrado". -->
<p th:if="${param.error != null and param.error[0] == 'propio'}">
    No puedes agregarte a ti mismo, ya perteneces al grupo como creador.
