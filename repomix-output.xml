<file path="src/main/resources/templates/grupo.html">
<!DOCTYPE html>
<html lang="es" xmlns:th="http://www.thymeleaf.org">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title th:text="${grupo.name}">Grupo</title>
</head>

<body>

<!-- ============================= -->
<!-- ENCABEZADO -->
<!-- ============================= -->

<header>

    <a href="/mis-grupos">
        ← Volver a mis grupos
    </a>
    <h1 th:text="${grupo.name}">
    </h1>

    <!-- Metadata del grupo: contexto secundario, no es lo primero que se lee -->
    <p>
        <small>
            Creado por
            <span th:text="${grupo.creador.name}">
            </span>
            el
            <span th:text="${grupo.fecha_creacion}">Fecha></span>
        </small>
    </p>
</header>

<!-- ============================= -->
<!-- TARJETA DE DEUDA (Sprint 6: ya conectada a DeudaService) -->
<!-- ============================= -->

<!-- balanceTotal es la suma de todas las líneas de "deudas": puede ser
     positivo (en total te deben), negativo (en total debes) o cero
     (estás a paz y salvo en este grupo) -->

<section>

    <p th:if="${balanceTotal.signum() > 0}">
        Te deben en total
    </p>

    <p th:if="${balanceTotal.signum() < 0}">
        Debes en total
    </p>

    <p th:if="${balanceTotal.signum() == 0}">
        Estás a paz y salvo
    </p>

    <!-- Mostramos el valor absoluto: el signo ya se explicó arriba
         con el texto ("Te deben" / "Debes"), así que aquí no
         repetimos el signo negativo -->
    <!-- #numbers.formatDecimal(numero, mínimoDígitosEnteros, separadorMiles, decimales, separadorDecimal)
         Con esto: 50000 se muestra como "50,000.00", no como el "50.0" crudo
         que BigDecimal guarda internamente -->
    <p th:text="'$' + ${#numbers.formatDecimal(balanceTotal.abs(), 1, 'COMMA', 0, 'POINT')}">
        $0.00
    </p>

</section>

<!-- ============================= -->
<!-- DESGLOSE POR PERSONA (Sprint 6, nuevo) -->
<!-- ============================= -->

<section>

    <h2>Detalle de tu deuda</h2>

    <div th:if="${#lists.isEmpty(deudas)}">
        <p>No tienes movimientos pendientes en este grupo.</p>
    </div>

    <ul th:unless="${#lists.isEmpty(deudas)}">

        <li th:each="deuda : ${deudas}">

            <!-- meDeben()/leDebo() ya vienen resueltos desde DeudaConPersona,
                 así que aquí solo decidimos qué texto mostrar según el signo -->

            <span th:if="${deuda.meDeben()}">
                <strong th:text="${deuda.otraPersona.name}">Nombre</strong>
                te debe
                <span th:text="'$' + ${#numbers.formatDecimal(deuda.monto, 1, 'COMMA', 0, 'POINT')}">$0.00</span>
            </span>

            <span th:if="${deuda.leDebo()}">
                Le debes a
                <strong th:text="${deuda.otraPersona.name}">Nombre</strong>
                <span th:text="'$' + ${#numbers.formatDecimal(deuda.monto.abs(), 1, 'COMMA', 0, 'POINT')}">$0.00</span>
            </span>

        </li>

    </ul>

</section>

<!-- ============================= -->
<!-- INTEGRANTES -->
<!-- ============================= -->

<section>

    <p>Integrantes:</p>

    <ul>

        <li th:each="miembro : ${miembros}">
            <span th:text="${miembro.usuario.name}">
            </span>
        </li>

    </ul>

</section>

<!-- ============================= -->
<!-- BOTÓN AGREGAR GASTO -->
<!-- ============================= -->

<a th:href="@{/grupo/{id}/gasto/nuevo(id=${grupo.id})}">
    <button type="button">+ Agregar gasto</button>
</a>

<!-- ============================= -->
<!-- HISTORIAL DE GASTOS -->
<!-- ============================= -->

<section>

    <h2>Historial de gastos</h2>


    <!-- No hay gastos -->

    <div th:if="${#lists.isEmpty(gastos)}">

        <p>
            Todavía no hay gastos registrados.
        </p>

    </div>


    <!-- Lista de gastos -->

    <div th:unless="${#lists.isEmpty(gastos)}">

        <article th:each="gasto : ${gastos}">

            <h3 th:text="${gasto.getDescripcion()}">
                Descripción del gasto
            </h3>

            <p>
                <strong>Monto:</strong>

                <span th:text="'$' + ${#numbers.formatDecimal(gasto.getMonto(), 1, 'COMMA', 0, 'POINT')}">
                    $0.00
                </span>
            </p>

            <p>
                <strong>Fecha:</strong>

                <span th:text="${gasto.getFecha()}">
                    00/00/0000
                </span>
            </p>

            <!-- CAMBIO (Sprint 6, ampliación): un gasto ya puede tener
                 VARIOS pagadores, cada uno con su propio monto (por eso
                 Gasto ya no tiene gasto.getUsuario()). Los pagos de
                 cada gasto llegan en el mapa "pagosPorGasto", que arma
                 el controlador usando el id de cada gasto como llave. -->

            <p>
                <strong>Pagó:</strong>
            </p>

            <ul>
                <li th:each="pago : ${pagosPorGasto.get(gasto.getId())}">
                    <span th:text="${pago.usuario.name}">Usuario</span>
                    —
                    <span th:text="'$' + ${#numbers.formatDecimal(pago.monto, 1, 'COMMA', 0, 'POINT')}">$0.00</span>
                </li>
            </ul>

            <hr>

        </article>

    </div>

</section>

</body>

</html>
